# SkyGuard AI — Oracle Cloud Gateway Configuration
# Problem Statement: SIH 26073 | India Meteorological Department

# [1] Official IMD API Credentials (generated on https://api.imd.gov.in)
IMD_API_KEY="your_imd_portal_x_api_key_here"
IMD_API_EMAIL="your_registered_email@domain.com"
IMD_API_PASSWORD="your_imd_portal_password_here"

# [2] Oracle Reserved Public IPv4 (The exact IP bound on the IMD portal)
EXPECTED_PUBLIC_IP="140.238.xxx.xxx"

# [3] SkyGuard Render Backend Webhook Configuration
RENDER_INGEST_URL="https://skyguard-ai.onrender.com/api/v1/ingestion/imd"
SKYGUARD_INGESTION_TOKEN="generate_a_random_secure_hex_token_here"

# [4] Cadence & Operation
INTERVAL_SECONDS="900"
