# SkyGuard AI - Production Environment Variables
NEXT_PUBLIC_APP_NAME=SkyGuard AI
NEXT_PUBLIC_APP_URL=https://skyguard-ai-iota.vercel.app
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
SKYGUARD_API_URL=http://localhost:8000
SKYGUARD_API_TIMEOUT_MS=55000
API_SECRET=replace-with-a-random-server-side-secret

# Data Source Mode: LIVE_IMD_AWS or FIXTURE_REPLAY
# If IMD_API_KEY is not set or network is unreachable, system defaults to FIXTURE_REPLAY safely.
SKYGUARD_DATA_SOURCE_MODE=FIXTURE_REPLAY

# Official IMD AWS collector (backend only; never prefix these with NEXT_PUBLIC_)
# The API key is bound by IMD to this backend's static public egress IP.
IMD_API_KEY=
IMD_API_EMAIL=
IMD_API_PASSWORD=
# Optional for a short manual test only. Production auto-creates JWTs
# from IMD_API_EMAIL + IMD_API_PASSWORD and keeps them in memory.
IMD_API_JWT_TOKEN=
# Set only after IMD's documented request limit/cadence has been confirmed.
IMD_API_MIN_INTERVAL_SECONDS=
# Keep false until real aws_data + aws_data_mapping payloads, units, timezone,
# identifiers, missing codes and application envelopes have been approved.
IMD_NORMALIZATION_ENABLED=false
IMD_SCHEMA_CONTRACT_PATH=
IMD_AWS_ENDPOINT=https://api.imd.gov.in/api/v1/aws_data
IMD_AWS_MAPPING_ENDPOINT=https://api.imd.gov.in/api/v1/aws_data_mapping

# Storage Configuration (Defaults to SQLite replay.db if DATABASE_URL is not set)
DATABASE_URL=
