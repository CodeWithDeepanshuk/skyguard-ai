# Public Frontend Configuration
NEXT_PUBLIC_APP_NAME=SkyGuard AI
NEXT_PUBLIC_APP_URL=https://skyguard-ai.vercel.app
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap

# External SkyGuard Python ML Inference Service (Render / Dedicated Host)
SKYGUARD_API_URL=https://skyguard-ai.onrender.com

# Database Connection (Optional external Postgres / Neon / Supabase)
DATABASE_URL=

# Server-Side Operational Secrets (Never prefix with NEXT_PUBLIC_)
API_SECRET=change_me_to_a_secure_random_hex_key
CRON_SECRET=change_me_to_a_secure_cron_token
ADMIN_SECRET=change_me_to_a_secure_admin_token

# Observability & Logging
LOG_LEVEL=info
NODE_ENV=production
