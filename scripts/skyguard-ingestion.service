[Unit]
Description=SkyGuard AI - Official IMD AWS Automated 15-Minute Ingestion Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/skyguard-ai
ExecStart=/bin/bash /home/ubuntu/skyguard-ai/scripts/run_ec2_daemon.sh
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
